# Local Mistral runtime. Ollama's OpenAI-compatible API is the default.
# The chat client appends /v1/chat/completions, so this is the origin only.
# The API runs in the dev container; Ollama runs on the host.
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=mistral:7b

# Corpus for the query API: meridian or coforge. Restart the API after changing it.
# Ingest and the eval scripts take the same names via --corpus. Each corpus has
# its own index under data/chromadb/<name> and data/keyword/<name>.sqlite.
RAG_CORPUS=meridian

# Optional override for a Chroma client opened without an explicit path.
# Pipeline scripts pass the corpus index path, so this does not select the corpus.
CHROMA_PERSIST_DIRECTORY=data/chromadb
