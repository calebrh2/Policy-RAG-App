# Copy this file to .env to override src/rag/config.py defaults.

# Models
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_TOKEN_LIMIT=480
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RAG_OLLAMA_MODEL=qwen3:8b

# Ollama on the host, as seen from the development container
RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
RAG_OLLAMA_TIMEOUT_SECONDS=120
RAG_OLLAMA_CONTEXT_WINDOW=8192
RAG_OLLAMA_THINK=false

# Persistent index and retrieval
RAG_CHROMA_PATH=data/chromadb
RAG_CHROMA_COLLECTION=policy_chunks
RAG_RETRIEVAL_CANDIDATES=10
RAG_RETRIEVAL_TOP_K=3
RAG_ROUTER_CONFIDENCE=0.70
RAG_EMBEDDING_BATCH_SIZE=16
